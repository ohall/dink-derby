{
  "name": "@dink-derby/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build -w @dink-derby/shared-types",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dink-derby/shared-types": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@supabase/supabase-js": "2.112.4",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.4.0",
    "@types/pg": "^8.10.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0",
    "vitest": "^4.0.14"
  }
}
