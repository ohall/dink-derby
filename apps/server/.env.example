# Database
DATABASE_URL=postgresql://postgres.project:password@region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Auth + private Storage (server only)
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=catch-photos

# Fish identification via OpenRouter (optional)
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
#OPENROUTER_REFERER=https://dinkderby.com

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
